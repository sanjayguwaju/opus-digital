---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Contact DTKSN - Get Your Free Quote Today',
  description:
    "Ready to start your digital project? Contact DTKSN for a free consultation. We're here to help transform your business with professional digital solutions.",
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText
    tagline="Get In Touch"
    title="Let's Build Something Amazing Together!"
    subtitle="Ready to transform your business with professional digital solutions? We're here to help you succeed. Get your free consultation today."
  />

  <ContactUs
    id="form"
    title="Start Your Digital Journey Today!"
    subtitle="Tell us about your project and we'll get back to you within 24 hours with a customized proposal. No obligation, just great ideas!"
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Full Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email Address',
      },
      {
        type: 'tel',
        name: 'phone',
        label: 'Phone Number',
      },
      {
        type: 'text',
        name: 'company',
        label: 'Company Name (Optional)',
      },
    ]}
    textarea={{
      label: 'Tell us about your project',
      placeholder: 'Describe your project, goals, timeline, and any specific requirements...',
    }}
    disclaimer={{
      label:
        'By submitting this form, you agree to our privacy policy and consent to being contacted about your project.',
    }}
    description="Our team typically responds within 24 hours. For urgent inquiries, call us directly or use WhatsApp."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Multiple Ways to Reach Us"
    subtitle="Choose the method that works best for you"
    items={[
      {
        title: 'WhatsApp Support',
        description: `Get instant responses to your questions via WhatsApp. Perfect for quick queries and project discussions. Available during business hours.`,
        icon: 'tabler:message-circle',
      },
      {
        title: 'Phone Consultation',
        description:
          'Call us directly for immediate assistance. Our team is ready to discuss your project and answer all your questions.',
        icon: 'tabler:phone',
      },
      {
        title: 'Email Support',
        description:
          "Send us detailed project requirements via email. We'll respond with a comprehensive proposal tailored to your needs.",
        icon: 'tabler:mail',
      },
      {
        title: 'Office Visit',
        description:
          "Visit our office in Kathmandu for face-to-face discussions. We're located in the heart of the city.",
        icon: 'tabler:map-pin',
      },
      {
        title: 'Video Call',
        description:
          'Schedule a video consultation for remote meetings. Perfect for clients outside Kathmandu or those who prefer virtual meetings.',
        icon: 'tabler:video',
      },
      {
        title: 'Social Media',
        description:
          'Follow us on social media for updates, tips, and to see our latest work. DM us for quick questions.',
        icon: 'tabler:brand-facebook',
      },
    ]}
  />

  <!-- Contact Information Section -->
  <!-- Contact Information Widget ****************** -->

  <Features2
    title="Contact Information"
    subtitle="Get in touch with us through any of these channels"
    tagline="Contact Us"
    classes={{
      container: 'max-w-6xl',
      panel:
        'group relative rounded-2xl p-6 bg-white dark:bg-slate-900 shadow-md hover:shadow-xl transition duration-300 hover:-translate-y-1 border border-transparent dark:border-slate-800',
      icon: 'w-12 h-12 mb-4 text-white bg-gradient-to-br from-blue-600 to-purple-600 p-3 rounded-xl shadow-lg',
    }}
    items={[
      {
        title: 'Phone',
        description:
          '+977 984-1234567<br/><span class="text-sm text-gray-500 dark:text-gray-400">Mon-Fri: 9 AM - 6 PM</span>',
        icon: 'tabler:phone',
      },
      {
        title: 'Email',
        description:
          'info@techfytra.com<br/><span class="text-sm text-gray-500 dark:text-gray-400">Response within 24 hours</span>',
        icon: 'tabler:mail',
      },
      {
        title: 'Office',
        description: 'Thamel, Kathmandu<br/><span class="text-sm text-gray-500 dark:text-gray-400">Nepal</span>',
        icon: 'tabler:map-pin',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Start Your Project',
        href: '#form',
        icon: 'tabler:rocket',
      },
    ]}
    title="Ready to Get Started?"
    subtitle="Don't wait to transform your business. Contact us today and let's create something amazing together. Your success is our priority."
  />
</Layout>
